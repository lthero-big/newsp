# newsp config — copy to ~/.config/newsp/env (chmod 600). Never commit the real file.
# Same names as the GitHub Actions secrets / variables (README).

# Site + owner passphrase (same value as the Worker secret RATINGS_TOKEN)
NEWS_SITE=https://news.example.com
RATINGS_TOKEN=

# Deploy: git (Worker connected to the repo via Workers Builds / Deploy to Cloudflare) | direct (npm run deploy = wrangler deploy) | none
NEWS_DEPLOY=git
# optional: preview branches (run-edition.sh --preview) wait on https://<branch>-<worker>.<subdomain>.workers.dev
NEWSP_WORKER=newsp
NEWSP_WORKERS_SUBDOMAIN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# LLM for the Chinese card copy. Provider presets: openai anthropic gemini xai mistral groq openrouter deepseek qwen glm kimi
# doubao siliconflow ollama custom. BASE_URL overrides the preset (proxy / gateway); custom needs BASE_URL + MODEL.
# Leave NEWS_LLM_PROVIDER empty (or NEWS_LLM=off) to keep the original titles.
NEWS_LLM_PROVIDER=deepseek
NEWS_LLM_BASE_URL=
NEWS_LLM_MODEL=
NEWS_LLM_API_KEY=
# optional second provider, tried when the first fails
NEWS_LLM_FALLBACK_PROVIDER=
NEWS_LLM_FALLBACK_BASE_URL=
NEWS_LLM_FALLBACK_MODEL=
NEWS_LLM_FALLBACK_API_KEY=

# X via your own RSSHub (https://docs.rsshub.app). Unset = no X cards.
RSSHUB_BASE=
RSSHUB_ACCESS_KEY=

# Notifications (any subset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_KEY=
BARK_KEY=
SERVERCHAN_KEY=
