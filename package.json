{
  "name": "newsp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "daily": "bash scripts/daily.sh",
    "publish": "bash scripts/publish.sh",
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "theme": "node scripts/theme.mjs",
    "test": "node --test tests/*.test.mjs && python3 -m unittest tests/test_arena_top.py && python3 -m unittest discover -s scripts/collect -p 'test_*.py'",
    "test:mobile": "npm run build --silent && node tests/mobile-layout.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  }
}
